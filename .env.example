# Firebase Console > Project settings > Your apps > Web app.
# These identify your Firebase project; access is controlled by authentication and rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Server-only: never prefix these with NEXT_PUBLIC_. Keep the JSON key outside the repository.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted PEM; escaped \n line breaks are accepted.
FIREBASE_PRIVATE_KEY=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOOKING_RATE_LIMIT_SECRET=

# Optional LOCAL emulator settings. NEVER set these on Vercel.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
